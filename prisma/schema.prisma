generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  password          String
  role              Role           @default(VIEWER)
  firstName         String?
  lastName          String?
  department        String?
  imageUrl          String?
  isVerified        Boolean        @default(false)
  verificationToken String?        @unique
  orders            Order[]
  payments          Payment[]
  notifications     Notification[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  borrowRequests BorrowRequest[]
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model Category {
  id            String     @id @default(cuid())
  name          String
  parentId      String?
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id])
  subCategories Category[] @relation("SubCategories")
  devices       Device[]
}

model Device {
  id               String         @id @default(cuid())
  name             String
  brand            String
  model            String
  serialNumber     String         @unique
  price            Decimal
  status           Status         @default(AVAILABLE)
  description      String
  specifications   Json
  workingPrinciple String         @db.Text
  purchaseDate     DateTime
  warrantyExpiry   DateTime
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  logs             InventoryLog[]
  orderItems       OrderItem[]
  stock          Int            @default(1)  
  borrowRequests BorrowRequest[]
  imageUrl         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model BorrowRequest {
  id          String        @id @default(cuid())
  deviceId    String
  userId      String
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      BorrowStatus  @default(PENDING)
  adminNote   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  device      Device        @relation(fields: [deviceId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
}

enum BorrowStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum Status {
  AVAILABLE
  IN_MAINTENANCE
  DEPLOYED
  RETIRED
}

model InventoryLog {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id])
  action      String
  remarks     String?
  performedAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal      Decimal       @default(0)
  discount      Decimal       @default(0)
  tax           Decimal       @default(0)
  total         Decimal       @default(0)
  notes         String?
  items         OrderItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  quantity  Int      @default(1)
  unitPrice Decimal
  total     Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([deviceId])
}

model Payment {
  id            String                   @id @default(cuid())
  orderId       String
  order         Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String
  user          User                     @relation(fields: [userId], references: [id])
  amount        Decimal
  method        PaymentMethod
  status        PaymentTransactionStatus @default(PENDING)
  transactionId String?                  @unique
  provider      String?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_BANKING
  OTHER
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}
